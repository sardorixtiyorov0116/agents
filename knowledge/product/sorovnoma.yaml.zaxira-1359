  # ---------------------------------------------------------------- 12
  kckp:
    nomi: "Markaziy qurilma КЦКП"
    nomi_ru: "КЦКП"
    belgi: "🏭"
    fayl: kckp.pdf
    izoh: "markaziy havo tayyorlash qurilmasi — seksiyalardan yig'iladi"
    # DIQQAT — QISQARTIRILGAN RO'YXAT.
    #
    # Zavodning КЦКП oprosniy listida 40 dan ortiq maydon bor: har
    # seksiya uchun alohida harorat, namlik, klass, quvvat. Telefondan
    # 40 ta savolga javob beradigan mijoz yo'q — u yarmida tashlab
    # ketadi va biz hech narsa olmaymiz.
    #
    # Shuning uchun bu yerda QURILMA O'LCHAMINI belgilaydigan savollar
    # qoldirilgan: sarf, bosim, joylashuv, seksiyalar tarkibi. Qolgan
    # tafsilotni menejer to'ldiradi — oxirgi savolda mijozga aynan shu
    # aytiladi va to'liq fayl taklif qilinadi.
    savollar:
      - kalit: tur
        matn: "Qurilma qaysi yo'nalishda?"
        tanlovlar:
          - {qiymat: "kirish (приточная)", yorliq: "Kirish", izoh: "toza havo beradi"}
          - {qiymat: "chiqish (вытяжная)", yorliq: "Chiqish", izoh: "havo so'rib chiqaradi"}
          - {qiymat: "kirish + chiqish", yorliq: "Kirish + chiqish"}

      - kalit: sarf
        matn: "Havo sarfi qancha? (m³/soat)"
        tekshir: son

      - kalit: bosim
        matn: "Erkin bosim qancha? (Pa)"
        izoh: "bilmasangiz o'tkazing"
        tekshir: son
        otkazsa_boladi: true

      - kalit: joylashuv
        matn: "Qurilma qayerda turadi?"
        tanlovlar:
          - {qiymat: "ichkarida", yorliq: "Bino ichida"}
          - {qiymat: "tashqarida", yorliq: "Tashqarida", izoh: "ko'chada, himoya korpusi bilan"}

      - kalit: konstruksiya
        matn: "Konstruksiyasi qanday?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "monoblok", yorliq: "Monoblok", izoh: "yaxlit korpus"}
          - {qiymat: "blokli", yorliq: "Blokli", izoh: "seksiyalab yig'iladi"}

      - kalit: ijro
        matn: "Ijro turi?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "umumsanoat", yorliq: "Umumsanoat"}
          - {qiymat: "gigienik", yorliq: "Gigienik", izoh: "oziq-ovqat, tibbiyot"}
          - {qiymat: "maxsus", yorliq: "Maxsus"}

      - kalit: xizmat_tomoni
        matn: "Xizmat ko'rsatish tomoni?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "o'ng", yorliq: "O'ng"}
          - {qiymat: "chap", yorliq: "Chap"}

      - kalit: isitgich
        matn: "Havo isitgich kerakmi?"
        tanlovlar:
          - {qiymat: "ВНВ suvli", yorliq: "Suvli (ВНВ)"}
          - {qiymat: "ВНП bug'li", yorliq: "Bug'li (ВНП)"}
          - {qiymat: "ВНЭ elektr", yorliq: "Elektrli (ВНЭ)"}
          - {qiymat: "kerak emas", yorliq: "Kerak emas"}

      - kalit: sovutgich
        matn: "Havo sovutgich kerakmi?"
        tanlovlar:
          - {qiymat: "ha", yorliq: "Ha, kerak"}
          - {qiymat: "yoq", yorliq: "Yo'q"}

      - kalit: filtr_klassi
        matn: "Filtr tozalash klassi?"
        izoh: "bilmasangiz o'tkazing — standart G4 qo'yiladi"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "G3", yorliq: "G3"}
          - {qiymat: "G4", yorliq: "G4"}
          - {qiymat: "F5-F7", yorliq: "F5–F7", izoh: "nozik tozalash"}
          - {qiymat: "F8-F9", yorliq: "F8–F9", izoh: "juda nozik"}

      - kalit: namlatgich
        matn: "Namlatish seksiyasi kerakmi?"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "sotali", yorliq: "Sotali namlatish"}
          - {qiymat: "sug'orish kamerasi", yorliq: "Sug'orish kamerasi"}
          - {qiymat: "bug'li", yorliq: "Bug'li namlatish"}
          - {qiymat: "kerak emas", yorliq: "Kerak emas"}

      - kalit: shovqin
        matn: "Shovqin o'chirish seksiyasi kerakmi?"
        tanlovlar:
          - {qiymat: "ha", yorliq: "Ha, kerak"}
          - {qiymat: "yoq", yorliq: "Yo'q"}

      - kalit: avtomatika
        matn: "Avtomatika shchiti kerakmi?"
        tanlovlar:
          - {qiymat: "ichiga qurilgan", yorliq: "Ichiga qurilgan"}
          - {qiymat: "devorga", yorliq: "Devorga o'rnatiladigan"}
          - {qiymat: "kerak emas", yorliq: "Kerak emas"}

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son
