# Oprosniy listlar — mijozlar botidagi bo'limlar va savollar.
#
# NEGA YAML, KOD EMAS
# -------------------
# Zavodda 12 ta oprosniy list bor va ular vaqti-vaqti bilan o'zgaradi
# (yangi model qatori qo'shiladi, klass o'chadi). Savollar kodda bo'lsa
# har o'zgarishga dasturchi kerak bo'lardi. Bu yerda esa muhandis o'zi
# tahrirlaydi.
#
# MANBA — zavodning haqiqiy oprosniy listlari (`hujjatlar/sorovnoma/`).
# Savol matni va variantlar O'YLAB TOPILMAGAN, o'sha fayllardan
# ko'chirilgan. Yangi variant qo'shishdan oldin faylni tekshiring.
#
# `shart` — savol faqat shu javob berilganda beriladi. Masalan F5-F9
# tozalash klassi FAQAT ФЯК filtrida bor; ФЯГ tanlagan mijozga uni
# ko'rsatish xato bo'lardi.

bolimlar:

  # ---------------------------------------------------------------- 1
  ventilyator:
    nomi: "Ventilyator"
    nomi_ru: "Вентилятор"
    belgi: "🌀"
    fayl: ventilyator.docx
    izoh: "radial, o'qli, kanalli, tomga o'rnatiladigan"
    savollar:
      - kalit: joy
        matn: "Ventilyator qayerga o'rnatiladi?"
        tanlovlar:
          - {qiymat: "bino ichida", yorliq: "Bino ichida"}
          - {qiymat: "kochada, soyabon ostida", yorliq: "Ko'chada, soyabon ostida"}
          - {qiymat: "kochada, soyabonsiz", yorliq: "Ko'chada, soyabonsiz"}

      - kalit: turi
        matn: "Ventilyator turi?"
        izoh: "bilmasangiz o'tkazing — sarf va bosimga qarab o'zimiz tanlaymiz"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "radial", yorliq: "Radial", izoh: "ВЦ 4-75, ВЦ 14-46, ВР 6-28, ВР 12-26"}
          - {qiymat: "radial changli", yorliq: "Radial changli", izoh: "ВР 6-45, ВЦП 7-40"}
          - {qiymat: "tomga (ВКР)", yorliq: "Tomga o'rnatiladigan", izoh: "ВКР"}
          - {qiymat: "tomga o'qli (ВКОП)", yorliq: "Tomga, o'qli podpor", izoh: "ВКОП"}
          - {qiymat: "oqli", yorliq: "O'qli", izoh: "ВО 6-300, ВОД-ДУ, СВМ, ВМЭ, ВОЭ"}
          - {qiymat: "kanalli", yorliq: "Kanalli", izoh: "ВК, ВКПП, ВКК"}

      - kalit: sarf
        matn: "Havo sarfi qancha? (m³/soat)"
        izoh: "bilmasangiz o'tkazing — obyekt o'lchamidan hisoblab beramiz"
        tekshir: son
        otkazsa_boladi: true

      - kalit: bosim
        matn: "To'liq bosim qancha? (Pa)"
        izoh: "bilmasangiz o'tkazing"
        tekshir: son
        otkazsa_boladi: true

      - kalit: havo
        matn: "Qanday havo tortiladi?"
        tanlovlar:
          - {qiymat: "toza havo", yorliq: "Toza havo"}
          - {qiymat: "changli", yorliq: "Changli"}
          - {qiymat: "agressiv/zararli aralashmali", yorliq: "Agressiv / zararli"}
          - {qiymat: "issiq havo", yorliq: "Issiq havo"}

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son

  # ---------------------------------------------------------------- 2
  panjara:
    nomi: "Ventilyatsiya panjaralari"
    nomi_ru: "Вентиляционные решётки"
    belgi: "▦"
    fayl: panjara.docx
    nom_qolipi: "{model} {olcham}"
    izoh: "РВН, РВИ, РВР, ДФА, DVS va boshqalar"
    savollar:
      - kalit: model
        matn: "Qaysi model?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "РВН", yorliq: "РВН", izoh: "havo berish (kirish)"}
          - {qiymat: "РВИ", yorliq: "РВИ", izoh: "havo so'rish (chiqish)"}
          - {qiymat: "РВР-1 / РВР-2", yorliq: "РВР-1 / РВР-2"}
          - {qiymat: "4РВП", yorliq: "4РВП"}
          - {qiymat: "ДФА", yorliq: "ДФА", izoh: "80…500"}
          - {qiymat: "ДФН", yorliq: "ДФН"}
          - {qiymat: "DVS / DVS-P", yorliq: "DVS / DVS-P", izoh: "100…200"}

      - kalit: olcham
        matn: "O'lchami qanday? (A×B, mm)"
        izoh: "masalan 300x150. Bilmasangiz o'tkazing — havo sarfidan hisoblaymiz"
        tekshir: bosh_bolmagan_matn
        otkazsa_boladi: true

      - kalit: krv
        matn: "KRV kerakmi? (havo sarfini rostlagich)"
        tanlovlar:
          - {qiymat: "ha", yorliq: "Ha, KRV bilan"}
          - {qiymat: "yoq", yorliq: "Yo'q, KRVsiz"}

      - kalit: rang
        matn: "Bo'yoq rangi? (RAL kodi)"
        izoh: "standart rang kerak bo'lsa o'tkazing"
        tekshir: bosh_bolmagan_matn
        otkazsa_boladi: true

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son

  # ---------------------------------------------------------------- 3
  filtr:
    nomi: "Filtrlar"
    nomi_ru: "Фильтры"
    belgi: "▤"
    fayl: filtr.docx
    nom_qolipi: "{turi} {olcham}"
    izoh: "ФЯК cho'ntakli, ФЯГ gofrali, ФЯП yassi"
    savollar:
      - kalit: turi
        matn: "Filtr turi?"
        tanlovlar:
          - {qiymat: "ФЯК", yorliq: "ФЯК — cho'ntakli", izoh: "yacheykali cho'ntakli"}
          - {qiymat: "ФЯГ", yorliq: "ФЯГ — gofrali", izoh: "yacheykali gofrali"}
          - {qiymat: "ФЯП", yorliq: "ФЯП — yassi", izoh: "yacheykali yassi"}

      - kalit: klass
        matn: "Tozalash klassi?"
        izoh: "G3-G4 dag'al, F5-F9 nozik tozalash"
        tanlovlar:
          - {qiymat: "G3", yorliq: "G3"}
          - {qiymat: "G4", yorliq: "G4"}
          - {qiymat: "F5", yorliq: "F5", shart_qiymat: "ФЯК"}
          - {qiymat: "F6", yorliq: "F6", shart_qiymat: "ФЯК"}
          - {qiymat: "F7", yorliq: "F7", shart_qiymat: "ФЯК"}
          - {qiymat: "F8", yorliq: "F8", shart_qiymat: "ФЯК"}
          - {qiymat: "F9", yorliq: "F9", shart_qiymat: "ФЯК"}
        # F klasslari FAQAT ФЯК da bor — zavod hujjatida shunday.
        shart_kalit: turi

      - kalit: olcham
        matn: "Kirish kesimi o'lchami? (A×B, mm)"
        tekshir: bosh_bolmagan_matn

      - kalit: chontak_uzunligi
        matn: "Cho'ntak uzunligi? (mm)"
        izoh: "faqat ФЯК uchun"
        tekshir: son
        otkazsa_boladi: true
        shart: {kalit: turi, qiymat: "ФЯК"}

      - kalit: chontak_soni
        matn: "Cho'ntaklar soni? (dona)"
        izoh: "faqat ФЯК uchun"
        tekshir: butun_son
        otkazsa_boladi: true
        shart: {kalit: turi, qiymat: "ФЯК"}

      - kalit: ramka
        matn: "Ramka qalinligi? (mm)"
        izoh: "faqat ФЯГ va ФЯП uchun"
        tekshir: son
        otkazsa_boladi: true
        shart: {kalit: turi, qiymat: ["ФЯГ", "ФЯП"]}

      - kalit: iqlim
        matn: "Iqlim ijrosi?"
        izoh: "У — mo''tadil iqlim, УХЛ — sovuq iqlim"
        tanlovlar:
          - {qiymat: "У", yorliq: "У"}
          - {qiymat: "УХЛ", yorliq: "УХЛ"}

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son

  # ---------------------------------------------------------------- 4
  shovqin:
    nomi: "Shovqin o'chirgichlar"
    nomi_ru: "Шумоглушители"
    belgi: "🔇"
    fayl: shovqin.docx
    nom_qolipi: "{turi} {olcham}"
    izoh: "plastinali П/ОП/ГП, quvurli ГТК/ГТП"
    savollar:
      - kalit: turi
        matn: "Shovqin o'chirgich turi?"
        izoh: "bilmasangiz o'tkazing — kanal o'lchamiga qarab tanlaymiz"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "П va ОП", yorliq: "П / ОП — plastinali", izoh: "plastinali va oqim yo'naltirgich"}
          - {qiymat: "ГП", yorliq: "ГП — plastinali", izoh: "to'g'ri burchakli kanalga"}
          - {qiymat: "ГТК", yorliq: "ГТК — dumaloq quvurli", izoh: "dumaloq kanalga"}
          - {qiymat: "ГТП", yorliq: "ГТП — to'g'ri burchakli quvurli"}

      - kalit: olcham
        matn: "Tipo o'lchami qanday?"
        izoh: "ОП uchun AxBxR, П va ГП uchun AxBxL, ГТК uchun dxDxL, ГТП uchun axb-AxB-L (mm)"
        tekshir: bosh_bolmagan_matn
        otkazsa_boladi: true

      - kalit: iqlim
        matn: "Iqlim ijrosi?"
        izoh: "У — mo''tadil iqlim, УХЛ — sovuq iqlim"
        tanlovlar:
          - {qiymat: "У", yorliq: "У"}
          - {qiymat: "УХЛ", yorliq: "УХЛ"}

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son

  # ---------------------------------------------------------------- 5
  klapan:
    nomi: "Klapanlar"
    nomi_ru: "Клапаны"
    belgi: "🔀"
    fayl: klapan.docx
    nom_qolipi: "{belgi} {kesim}"
    izoh: "КОГ, КВУ, КОП, КО, ДКС va boshqalar"
    savollar:
      - kalit: belgi
        matn: "Qaysi klapan kerak?"
        tanlovlar:
          - {qiymat: "КОГ", yorliq: "КОГ", izoh: "olovni ushlab qoluvchi"}
          - {qiymat: "АВКв", yorliq: "АВКв", izoh: "alyumin, portlashdan himoyalangan"}
          - {qiymat: "КВУ", yorliq: "КВУ", izoh: "universal havo klapani"}
          - {qiymat: "КОП", yorliq: "КОП", izoh: "teskari, to'g'ri burchakli"}
          - {qiymat: "КО / RSK", yorliq: "КО / RSK", izoh: "teskari, dumaloq"}
          - {qiymat: "КОПв / КОВ", yorliq: "КОПв / КОВ", izoh: "teskari, portlashdan himoyalangan"}
          - {qiymat: "КС", yorliq: "КС", izoh: "o'zi ochiluvchi"}
          - {qiymat: "КЛ", yorliq: "КЛ", izoh: "yaproqli"}
          - {qiymat: "ДКСП", yorliq: "ДКСП", izoh: "drossel, to'g'ri burchakli"}
          - {qiymat: "ДКСК / ДК", yorliq: "ДКСК / ДК", izoh: "drossel, dumaloq"}

      - kalit: kesim
        matn: "Ishchi kesimi qanday?"
        izoh: "to'g'ri burchakli uchun AxB (mm), dumaloq uchun D (mm)"
        tekshir: bosh_bolmagan_matn

      - kalit: ijro
        matn: "Ijrosi?"
        izoh: "Н — umumsanoat, К — korroziyaga chidamli"
        tanlovlar:
          - {qiymat: "Н", yorliq: "Н — umumsanoat"}
          - {qiymat: "К", yorliq: "К — korroziyabardosh"}

      - kalit: yuritma
        matn: "Zaslonkani nima boshqaradi?"
        tanlovlar:
          - {qiymat: "qolda", yorliq: "Qo'lda"}
          - {qiymat: "elektr yuritma", yorliq: "Elektr yuritma"}

      - kalit: iqlim
        matn: "Iqlim ijrosi?"
        izoh: "У — mo''tadil iqlim, УХЛ — sovuq iqlim"
        tanlovlar:
          - {qiymat: "У", yorliq: "У"}
          - {qiymat: "УХЛ", yorliq: "УХЛ"}

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son

  # ---------------------------------------------------------------- 6
  yongin_klapani:
    nomi: "Yong'in klapanlari"
    nomi_ru: "Противопожарные клапаны"
    belgi: "🔥"
    fayl: yongin_klapani.docx
    nom_qolipi: "{belgi} {kesim}"
    izoh: "КПУ universal, КПД tutun klapani"
    savollar:
      - kalit: belgi
        matn: "Qaysi klapan?"
        tanlovlar:
          - {qiymat: "КПУ", yorliq: "КПУ — universal", izoh: "yong'inga qarshi universal"}
          - {qiymat: "КПД", yorliq: "КПД — tutun klapani", izoh: "tutun chiqarish tizimiga"}

      - kalit: holati
        matn: "Odatdagi holati qanday?"
        tanlovlar:
          - {qiymat: "НО", yorliq: "НО — ochiq", izoh: "yong'inda yopiladi"}
          - {qiymat: "НЗ", yorliq: "НЗ — yopiq", izoh: "yong'inda ochiladi"}
          - {qiymat: "ДД", yorliq: "ДД — ikki tomonlama", izoh: "yong'inda yopilib, keyin ochiladi"}

      - kalit: kesim
        matn: "Ishchi kesimi qanday?"
        izoh: "to'g'ri burchakli uchun AxB (mm), dumaloq uchun D (mm)"
        tekshir: bosh_bolmagan_matn

      - kalit: mahkamlash
        matn: "Qanday mahkamlanadi?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "СТ", yorliq: "СТ — devorga", izoh: "bitta flanets"}
          - {qiymat: "КН", yorliq: "КН — kanalga", izoh: "ikkita flanets"}
          - {qiymat: "НП", yorliq: "НП — nippelli", izoh: "dumaloq kesim uchun"}

      - kalit: yuritma_joyi
        matn: "Yuritma qayerda joylashsin?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "ВУП", yorliq: "ВУП — ichkarida"}
          - {qiymat: "НУП", yorliq: "НУП — tashqarida"}

      - kalit: yuritma
        matn: "Yuritma turi?"
        izoh: "bilmasangiz o'tkazing — loyihaga qarab tanlaymiz"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "ЭМ", yorliq: "ЭМ", izoh: "prujinali, termoqulf bilan"}
          - {qiymat: "ЭМ1", yorliq: "ЭМ1", izoh: "prujinali, termoqulfsiz"}
          - {qiymat: "ЭР", yorliq: "ЭР", izoh: "reversiv, datchik bilan"}
          - {qiymat: "ЭР1", yorliq: "ЭР1", izoh: "reversiv, datchiksiz"}
          - {qiymat: "ЭТ3", yorliq: "ЭТ3", izoh: "dublyor issiqlik qulfi bilan"}

      - kalit: ijro
        matn: "Ijrosi?"
        izoh: "Н — umumsanoat, К — korroziyaga chidamli"
        tanlovlar:
          - {qiymat: "Н", yorliq: "Н — umumsanoat"}
          - {qiymat: "К", yorliq: "К — korroziyabardosh"}

      - kalit: qoshimcha
        matn: "Qo'shimcha jihoz kerakmi?"
        izoh: "Р — jalyuzi panjara, РД — dekorativ alyumin panjara, SO — to'siq to'r, ПКС — dumaloq kesimga o'tkazgich. Kerak bo'lmasa o'tkazing"
        tekshir: bosh_bolmagan_matn
        otkazsa_boladi: true

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son

  # ---------------------------------------------------------------- 7
  issiqlik_almashtirgich:
    nomi: "Issiqlik almashtirgich"
    nomi_ru: "Теплообменник"
    belgi: "♨️"
    fayl: issiqlik_almashtirgich.docx
    nom_qolipi: "{turi}"
    izoh: "mis-alyumin ВНВ (isitgich), ВОВ (sovutgich)"
    savollar:
      - kalit: turi
        matn: "Qaysi turi kerak?"
        tanlovlar:
          - {qiymat: "ВНВ", yorliq: "ВНВ — isitgich", izoh: "suvli havo isitgich"}
          - {qiymat: "ВОВ", yorliq: "ВОВ — sovutgich", izoh: "suvli havo sovutgich"}

      - kalit: montaj
        matn: "Qanday o'rnatiladi?"
        tanlovlar:
          - {qiymat: "flanetsli", yorliq: "Flanetsli ulanish"}
          - {qiymat: "ichiga quriladigan", yorliq: "Ichiga quriladigan"}

      - kalit: sarf
        matn: "Havo sarfi qancha? (m³/soat)"
        tekshir: son

      - kalit: kirish_harorati
        matn: "Havo kirishdagi harorati? (°C)"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tekshir: bosh_bolmagan_matn

      - kalit: chiqish_harorati
        matn: "Havo chiqishdagi harorati? (°C)"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tekshir: bosh_bolmagan_matn

      - kalit: quvvat
        matn: "Quvvati qancha? (kVt)"
        izoh: "bilmasangiz o'tkazing — havo sarfi va haroratdan hisoblaymiz"
        otkazsa_boladi: true
        tekshir: son

      - kalit: issiqlik_tashuvchi
        matn: "Issiqlik tashuvchi nima?"
        tanlovlar:
          - {qiymat: "suv", yorliq: "Suv"}
          - {qiymat: "antifriz", yorliq: "Antifriz"}
          - {qiymat: "bug'", yorliq: "Bug'"}

      - kalit: antifriz_foizi
        matn: "Antifriz foizi qancha? (%)"
        tekshir: son
        otkazsa_boladi: true
        shart: {kalit: issiqlik_tashuvchi, qiymat: "antifriz"}

      - kalit: quvur_diametri
        matn: "Mis quvur diametri?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "9,52 mm", yorliq: "9,52 mm"}
          - {qiymat: "12,7 mm", yorliq: "12,7 mm"}
          - {qiymat: "16 mm", yorliq: "16 mm"}

      - kalit: qatorlar
        matn: "Qatorlar soni? (dona)"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tekshir: butun_son

      - kalit: qoplama
        matn: "Lamel qoplamasi kerakmi?"
        tanlovlar:
          - {qiymat: "qoplamasiz", yorliq: "Qoplamasiz"}
          - {qiymat: "gidrofil qoplama", yorliq: "Gidrofil qoplama", izoh: "namli muhitga"}

      - kalit: soni
        matn: "Nechta kerak?"
        tekshir: butun_son

  # ---------------------------------------------------------------- 8
  siklon:
    nomi: "Siklon / aspiratsiya"
    nomi_ru: "Аспирационное оборудование"
    belgi: "🌪"
    fayl: siklon.docx
    nom_qolipi: "{marka}"
    izoh: "ЦН-11, ЦН-15, 4БЦШ, ЗИЛ — chang tozalash"
    savollar:
      - kalit: marka
        matn: "Qaysi marka?"
        izoh: "bilmasangiz o'tkazing — chang tarkibiga qarab tanlaymiz"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "ЦН-11", yorliq: "ЦН-11", izoh: "400…800"}
          - {qiymat: "ЦН-15", yorliq: "ЦН-15", izoh: "300…1400"}
          - {qiymat: "4БЦШ", yorliq: "4БЦШ", izoh: "200…600"}
          - {qiymat: "ЗИЛ", yorliq: "ЗИЛ", izoh: "900М, 1600М"}

      - kalit: sarf
        matn: "Tozalanadigan gaz sarfi qancha? (m³/soat)"
        tekshir: son

      - kalit: harorat
        matn: "Gaz harorati qancha? (°C)"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tekshir: bosh_bolmagan_matn

      - kalit: chang_tabiati
        matn: "Chang qanaqa?"
        izoh: "abraziv, yopishqoq, portlash xavfli, tolali va h.k. — bilganingizni yozing"
        tekshir: bosh_bolmagan_matn
        otkazsa_boladi: true

      - kalit: zarra_olchami
        matn: "Chang zarralari qanchalik mayda?"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tanlovlar:
          - {qiymat: "5 mkm gacha", yorliq: "5 mkm gacha", izoh: "faqat ЦН-11 uchun"}
          - {qiymat: "5-10 mkm", yorliq: "5–10 mkm"}
          - {qiymat: "10-20 mkm", yorliq: "10–20 mkm"}
          - {qiymat: "20-40 mkm", yorliq: "20–40 mkm"}
          - {qiymat: "40-60 mkm", yorliq: "40–60 mkm"}
          - {qiymat: "60 mkm dan katta", yorliq: "60 mkm dan katta"}

      - kalit: konsentratsiya
        matn: "Kirishdagi chang konsentratsiyasi? (g/m³)"
        izoh: "bilmasangiz o'tkazing"
        otkazsa_boladi: true
        tekshir: son

      - kalit: tozalash_darajasi
        matn: "Qanday tozalash darajasi kerak?"
        tanlovlar:
